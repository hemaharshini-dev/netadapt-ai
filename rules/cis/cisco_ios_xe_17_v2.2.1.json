{
  "framework": "CIS",
  "benchmark": "Cisco IOS XE 17.x",
  "benchmark_version": "2.2.1",
  "vendor": "Cisco",
  "platform": "IOS XE",

  "rules": [
    {
      "rule_id": "1.1.1",
      "title": "Enable aaa new-model",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "authentication.aaa_enabled",
        "type": "boolean"
      },

      "condition": {
        "operator": "equals",
        "expected": true
      },

      "remediation": {
        "commands": ["aaa new-model"]
      }
    },

    {
      "rule_id": "1.1.2",
      "title": "Enable aaa authentication login",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "authentication.login_authentication",
        "type": "object"
      },

      "condition": {
        "operator": "exists"
      },

      "remediation": {
        "commands": [
          "aaa authentication login <method-list> <authentication-method>"
        ]
      }
    },

    {
      "rule_id": "1.2.2",
      "title": "Set transport input ssh for line vty connections",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "management.vty[*].transport",
        "type": "list"
      },

      "condition": {
        "operator": "contains",
        "expected": "ssh"
      },

      "remediation": {
        "commands": ["line vty <line-range>", "transport input ssh"]
      }
    },

    {
      "rule_id": "1.2.5",
      "title": "Set access-class for line vty",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "management.vty[*].access_class",
        "type": "value"
      },

      "condition": {
        "operator": "exists"
      },

      "remediation": {
        "commands": [
          "line vty <line-range>",
          "access-class <vty_acl_number> in"
        ]
      }
    },

    {
      "rule_id": "1.2.8",
      "title": "Set exec-timeout to <=10 min line vty",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "management.vty[*].exec_timeout_seconds",
        "type": "number",
        "unit": "seconds"
      },

      "condition": {
        "operator": "less_than_or_equal",
        "expected": 600
      },

      "remediation": {
        "commands": ["line vty <line-range>", "exec-timeout 10 0"]
      }
    },

    {
      "rule_id": "1.4.2",
      "title": "Enable service password-encryption",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "services.password_encryption",
        "type": "boolean"
      },

      "condition": {
        "operator": "equals",
        "expected": true
      },

      "remediation": {
        "commands": ["service password-encryption"]
      }
    },

    {
      "rule_id": "1.4.3",
      "title": "Set username secret for all local users",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "authentication.local_users[*].credential_type",
        "type": "list"
      },

      "condition": {
        "operator": "all_equals",
        "expected": "secret"
      },

      "remediation": {
        "commands": ["username <LOCAL_USERNAME> secret <LOCAL_PASSWORD>"]
      }
    },

    {
      "rule_id": "2.1.1.1.1",
      "title": "Set hostname",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "device.hostname",
        "type": "string"
      },

      "condition": {
        "operator": "exists"
      },

      "remediation": {
        "commands": ["hostname <router_name>"]
      }
    },

    {
      "rule_id": "2.1.1.1.2",
      "title": "Set ip domain-name",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "device.domain_name",
        "type": "string"
      },

      "condition": {
        "operator": "exists"
      },

      "remediation": {
        "commands": ["ip domain-name <domain-name>"]
      }
    },

    {
      "rule_id": "2.1.1.1.4",
      "title": "Set SSH timeout to 60 seconds or less",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "management.ssh.timeout",
        "type": "number",
        "unit": "seconds"
      },

      "condition": {
        "operator": "less_than_or_equal",
        "expected": 60
      },

      "remediation": {
        "commands": ["ip ssh time-out 60"]
      }
    },

    {
      "rule_id": "2.1.1.1.5",
      "title": "Set SSH authentication retries to 3 or less",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "management.ssh.authentication_retries",
        "type": "number"
      },

      "condition": {
        "operator": "less_than_or_equal",
        "expected": 3
      },

      "remediation": {
        "commands": ["ip ssh authentication-retries 3"]
      }
    },

    {
      "rule_id": "2.1.4",
      "title": "Disable DHCP service",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "services.dhcp",
        "type": "boolean"
      },

      "condition": {
        "operator": "equals",
        "expected": false
      },

      "remediation": {
        "commands": ["no service dhcp"]
      }
    },

    {
      "rule_id": "2.2.1",
      "title": "Enable logging",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "logging.enabled",
        "type": "boolean"
      },

      "condition": {
        "operator": "equals",
        "expected": true
      },

      "remediation": {
        "commands": ["archive", "log config", "logging enable", "end"]
      }
    },

    {
      "rule_id": "2.2.2",
      "title": "Configure logging buffered",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "logging.buffered.size",
        "type": "number",
        "unit": "bytes"
      },

      "condition": {
        "operator": "greater_than_or_equal",
        "expected": 64000
      },

      "remediation": {
        "commands": ["logging buffered 64000"]
      }
    },

    {
      "rule_id": "2.3.1.1",
      "title": "Enable NTP authentication",
      "assessment_status": "Automated",
      "profile": "Level 1",

      "target": {
        "path": "ntp.authentication_enabled",
        "type": "boolean"
      },

      "condition": {
        "operator": "equals",
        "expected": true
      },

      "remediation": {
        "commands": ["ntp authenticate"]
      }
    }
  ]
}
